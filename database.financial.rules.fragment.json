{
  "rules": {
    "payments": {
      ".indexOn": ["createdAt"],
      "$paymentId": {
        ".write": false,
        ".read": "auth != null && data.child('payerId').val() === auth.uid"
      }
    },
    "paymentSessions": {
      ".indexOn": ["createdAt"],
      "$sessionId": {
        ".write": false,
        ".read": "auth != null && data.child('payerId').val() === auth.uid"
      }
    },
    "paymentRefunds": {
      ".indexOn": ["createdAt"],
      "$refundId": {
        ".write": false,
        ".read": "auth != null && data.child('requestedBy').val() === auth.uid"
      }
    },
    "paymentAllocations": {
      "$paymentId": {
        "$allocationId": {
          ".write": false,
          ".read": "auth != null && (root.child('payments').child($paymentId).child('payerId').val() === auth.uid || data.child('beneficiaryId').val() === auth.uid)"
        }
      }
    },
    "paymentSettlements": {
      "$settlementId": {
        ".write": false,
        ".read": "auth != null && data.child('beneficiaryId').val() === auth.uid"
      }
    },
    "wallets": {
      "$walletId": {
        ".write": false,
        ".read": "auth != null && data.child('ownerId').val() === auth.uid"
      }
    },
    "ledger": {
      "$entryId": {
        ".write": false,
        ".read": "auth != null && data.child('ownerId').val() === auth.uid"
      }
    },
    "cashCollections": {
      "$paymentId": {
        ".write": false,
        ".read": "auth != null && (data.child('payerId').val() === auth.uid || data.child('collectorId').val() === auth.uid)"
      }
    },
    "payoutProfiles": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    "payoutRequests": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "uid",
        "status"
      ]
    },
    "payouts": {
      "$payoutId": {
        ".write": false,
        ".read": "auth != null && data.child('beneficiaryId').val() === auth.uid"
      }
    },
    "refunds": {
      ".indexOn": ["createdAt"],
      "$refundId": {
        ".write": false,
        ".read": "auth != null && data.child('requestedBy').val() === auth.uid"
      }
    },
    "finance": {
      ".read": false,
      ".write": false,
      "operations": {
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "paymentProviderEvents": {
      ".read": false,
      ".write": false
    },
    "cashHandovers": {
      ".read": false,
      ".write": false
    },
    "cashRemittances": {
      ".read": false,
      ".write": false
    },
    "cashReconciliations": {
      ".read": false,
      ".write": false
    },
    "pricing": {
      ".read": false,
      ".write": false,
      "config": {
        ".read": false,
        ".write": false
      },
      "configHistory": {
        ".read": false,
        ".write": false
      },
      "quotes": {
        ".read": false,
        ".write": false
      },
      "discounts": {
        ".read": false,
        ".write": false
      }
    }
  }
}
