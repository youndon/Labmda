{
  "rules": {
    "payments": {
      "$paymentId": {
        ".write": false,
        ".read": "auth != null && data.child('payerId').val() === auth.uid"
      },
      ".indexOn": [
        "status",
        "provider"
      ]
    },
    "paymentAllocations": {
      "$paymentId": {
        "$allocationId": {
          ".write": false,
          ".read": "auth != null && (root.child('payments').child($paymentId).child('payerId').val() === auth.uid || data.child('beneficiaryId').val() === auth.uid)"
        }
      }
    },
    "paymentSettlements": {
      "$settlementId": {
        ".write": false,
        ".read": "auth != null && data.child('beneficiaryId').val() === auth.uid"
      }
    },
    "wallets": {
      "$walletId": {
        ".write": false,
        ".read": "auth != null && data.child('ownerId').val() === auth.uid"
      }
    },
    "ledger": {
      "$entryId": {
        ".write": false,
        ".read": "auth != null && data.child('ownerId').val() === auth.uid"
      }
    },
    "cashCollections": {
      "$paymentId": {
        ".write": false,
        ".read": "auth != null && (data.child('payerId').val() === auth.uid || data.child('collectorId').val() === auth.uid)"
      },
      ".indexOn": [
        "collectorId",
        "status"
      ]
    },
    "payoutProfiles": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    "payoutRequests": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "uid",
        "status",
        "transferReference"
      ]
    },
    "payouts": {
      "$payoutId": {
        ".write": false,
        ".read": "auth != null && data.child('beneficiaryId').val() === auth.uid"
      }
    },
    "refunds": {
      "$refundId": {
        ".write": false,
        ".read": "auth != null && data.child('requestedBy').val() === auth.uid"
      }
    },
    "finance": {
      ".read": false,
      ".write": false,
      "operations": {
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "paymentProviderEvents": {
      ".read": false,
      ".write": false
    },
    "cashHandovers": {
      ".read": false,
      ".write": false
    },
    "cashRemittances": {
      ".read": false,
      ".write": false
    },
    "cashReconciliations": {
      ".read": false,
      ".write": false
    },
    "pricing": {
      ".read": false,
      ".write": false,
      "config": {
        ".read": false,
        ".write": false
      },
      "configHistory": {
        ".read": false,
        ".write": false
      },
      "quotes": {
        ".read": false,
        ".write": false
      },
      "discounts": {
        ".read": false,
        ".write": false
      }
    },
    "expectedBdoSettlements": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "transferReference"
      ]
    },
    "bdoBankTransfers": {
      ".read": false,
      ".write": false
    },
    "bdoReconciliations": {
      ".read": false,
      ".write": false
    },
    "refundCases": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "createdAt",
        "status",
        "paymentId"
      ]
    },
    "adminAuditLogs": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "createdAt",
        "actorUid",
        "action"
      ]
    },
    "financeReconciliations": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "createdAt"
      ]
    },
    "financialAdjustmentRequests": {
      ".read": false,
      ".write": false
    },
    "bdoPaymentConfirmations": {
      ".read": false,
      ".write": false
    },
    "bdoPaymentReferenceIndex": {
      ".read": false,
      ".write": false
    },
    "bdoCheckoutLinkIndex": {
      ".read": false,
      ".write": false
    },
    "paymentConfig": {
      ".read": false,
      ".write": false
    },
    "cashControls": {
      ".read": false,
      ".write": false
    },
    "adminCashAlerts": {
      ".read": false,
      ".write": false
    },
    "paymentNotifications": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "adminPaymentNotifications": {
      ".read": "auth != null && auth.token.admin == true",
      ".write": false
    },
    "adminFcmTokens": {
      ".read": false,
      ".write": false
    },
    "paymentNotificationEvents": {
      ".read": false,
      ".write": false
    },
    "bdoPaymentReminderState": {
      ".read": false,
      ".write": false
    },
    "users": {
      "$uid": {
        "fcmTokens": {
          ".read": false,
          ".write": false
        }
      }
    }
  }
}
