{
  "rules": {
    "orders": {
      ".read": "auth != null && ((query.orderByChild == 'clientId' && query.equalTo == auth.uid) || (query.orderByChild == 'sourceId' && ((query.equalTo == auth.uid) || (root.child('shops').child(query.equalTo).child('ownerUid').val() == auth.uid) || (root.child('restaurants').child(query.equalTo).child('ownerUid').val() == auth.uid) || (root.child('restaurants').child(query.equalTo).child('managerId').val() == auth.uid))) || (query.orderByChild == 'deliveryId' && query.equalTo == auth.uid) || (query.orderByChild == 'status' && query.equalTo == 'OUT_FOR_DELIVERY' && root.child('users').child(auth.uid).child('deliveryServices').child('status').val() == 'APPROVED' && root.child('users').child(auth.uid).child('deliveryServices').child('isOnline').val() == true))",
      ".write": false,
      ".indexOn": [
        "clientId",
        "sourceId",
        "deliveryId",
        "status"
      ],
      "$orderId": {
        ".read": "auth != null && (data.child('clientId').val() == auth.uid || data.child('deliveryId').val() == auth.uid || data.child('sourceId').val() == auth.uid || root.child('shops').child(data.child('sourceId').val()).child('ownerUid').val() == auth.uid || root.child('restaurants').child(data.child('sourceId').val()).child('ownerUid').val() == auth.uid || root.child('restaurants').child(data.child('sourceId').val()).child('managerId').val() == auth.uid)",
        ".write": false
      }
    },
    "trips": {
      ".read": "auth != null && ((query.orderByChild == 'passengerId' && query.equalTo == auth.uid) || (query.orderByChild == 'driverId' && query.equalTo == auth.uid) || (query.orderByChild == 'status' && query.equalTo == 'REQUESTED' && root.child('users').child(auth.uid).child('driverService').child('status').val() == 'APPROVED' && root.child('users').child(auth.uid).child('driverService').child('isOnline').val() == true))",
      ".write": false,
      ".indexOn": [
        "passengerId",
        "driverId",
        "status"
      ],
      "$tripId": {
        ".read": "auth != null && (data.child('passengerId').val() == auth.uid || data.child('driverId').val() == auth.uid)",
        ".write": false
      }
    },
    "driverPresence": {
      ".read": "auth != null && root.child('activeRideRequests').child(auth.uid).exists()",
      ".write": false
    },
    "users": {
      ".indexOn": [
        "driverService/status",
        "deliveryServices/status",
        "foodStatus",
        "freightStatus"
      ],
      "$uid": {
        "driverService": {
          "id": {
            ".write": "auth != null && auth.uid == $uid && newData.val() == $uid"
          },
          "vehicleInfo": {
            "type": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            },
            "make": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            },
            "model": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            },
            "color": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            },
            "licensePlate": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            },
            "serviceType": {
              ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() != 'APPROVED'"
            }
          },
          "status": {
            ".write": "auth != null && auth.uid == $uid && ((!data.exists() && newData.val() == 'PENDING') || newData.val() == data.val())"
          },
          "isOnline": {
            ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('driverService').child('status').val() == 'APPROVED'",
            ".validate": "newData.isBoolean()"
          }
        },
        "deliveryServices": {
          "status": {
            ".write": "auth != null && auth.uid == $uid && ((!data.exists() && newData.val() == 'PENDING') || newData.val() == data.val())"
          },
          "isOnline": {
            ".write": "auth != null && auth.uid == $uid && root.child('users').child($uid).child('deliveryServices').child('status').val() == 'APPROVED'"
          }
        },
        "foodStatus": {
          ".write": false
        },
        "foodMode": {
          ".write": false
        },
        "shopStatus": {
          ".write": false
        },
        "shopMode": {
          ".write": false
        },
        "freightStatus": {
          ".write": false
        }
      }
    },
    "shops": {
      ".indexOn": [
        "ownerUid"
      ],
      "$shopId": {
        "status": {
          ".write": false
        },
        "isOnline": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "name": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "description": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "category": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "phone": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "address": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "imageUrl": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "latitude": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        },
        "longitude": {
          ".write": "auth != null && root.child('shops').child($shopId).child('ownerUid').val() == auth.uid && root.child('shops').child($shopId).child('status').val() == 'APPROVED'"
        }
      }
    },
    "restaurants": {
      "$restaurantId": {
        "status": {
          ".write": false
        },
        "isOpen": {
          ".write": "auth != null && auth.uid == $restaurantId && root.child('restaurants').child($restaurantId).child('status').val() == 'APPROVED'"
        },
        "imageUrl": {
          ".write": "auth != null && auth.uid == $restaurantId && root.child('restaurants').child($restaurantId).child('status').val() == 'APPROVED'"
        }
      }
    },
    "shopProducts": {
      "$shopId": {
        ".read": "auth != null && (root.child('shops').child($shopId).child('status').val() == 'APPROVED' || root.child('shops').child($shopId).child('ownerUid').val() == auth.uid)"
      }
    },
    "restaurantMeals": {
      "$restaurantId": {
        ".read": "auth != null && (root.child('restaurants').child($restaurantId).child('status').val() == 'APPROVED' || $restaurantId == auth.uid || root.child('restaurants').child($restaurantId).child('managerId').val() == auth.uid)"
      }
    },
    "activeRideRequests": {
      ".read": "auth != null && $passengerUid == auth.uid",
      ".write": false
    },
    "driverLocations": {
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && (!newData.exists() || (root.child('users').child($uid).child('driverService').child('status').val() == 'APPROVED' && root.child('users').child($uid).child('driverService').child('isOnline').val() == true))",
        ".validate": "!newData.exists() || (newData.hasChildren(['latitude','longitude']) && newData.child('latitude').isNumber() && newData.child('longitude').isNumber() && newData.child('latitude').val() >= -90 && newData.child('latitude').val() <= 90 && newData.child('longitude').val() >= -180 && newData.child('longitude').val() <= 180)"
      }
    }
  }
}
