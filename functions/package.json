{
  "name": "labmda-functions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.cjs",
    "serve": "npm run build && cd .. && firebase --config firebase.emulator.json emulators:start --project demo-labmda --only functions,database,auth",
    "deploy": "npm run build && cd .. && firebase deploy --only functions",
    "logs": "cd .. && firebase functions:log",
    "test:payout-migration": "node --test test/payout-migration.test.cjs",
    "migrate:payouts": "node scripts/migrate-payout-requests.cjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.30"
  }
}
