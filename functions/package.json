{
  "name": "labmda-functions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test:rules": "firebase emulators:exec --config ../firebase.emulator.json --project demo-labmda --only auth,database,functions \"node --test test/database.rules.test.cjs\"",
    "serve": "npm run build && cd .. && firebase --config firebase.emulator.json emulators:start --project demo-labmda --only functions,database,auth",
    "deploy": "npm run build && cd .. && firebase deploy --only functions",
    "logs": "cd .. && firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.7.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.30",
    "firebase": "^11.10.0"
  }
}
