<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
        <!-- 1. Mandatory Network Permissions -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 2. Location Permissions (GPS & Triangulation) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 3. Background/Foreground Ride Tracking (Android 10+ / 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

        <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
        <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
            tools:ignore="BackgroundLocationPolicy" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCTxle8zvYU-pM41AS2MR2zoWo2gO9gRwk" />

        <!-- Background FCM Service -->

        <!-- Default Notification Channel Config -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="order_status_channel" />
    </application>
</manifest>